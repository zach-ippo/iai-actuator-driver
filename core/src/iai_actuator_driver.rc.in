/* Version resource of the shared library on Windows (iai_actuator_driver.dll): the core's version and the C ABI
 * version, shown in the file's Properties > Details, so support can read both on a customer PC. CMake (configure_file)
 * and core/build.py fill in the @...@ values from include/iai_actuator_driver/version.hpp and the two C headers. */
1 VERSIONINFO
FILEVERSION @IAD_RC_VERSION@
PRODUCTVERSION @IAD_RC_VERSION@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "iai-actuator-driver native core, C ABI @IAD_ABI_VERSION@ (unofficial: not an IAI product)"
            VALUE "FileVersion", "@IAD_VERSION@"
            VALUE "InternalName", "iai_actuator_driver"
            VALUE "OriginalFilename", "iai_actuator_driver.dll"
            VALUE "ProductName", "iai-actuator-driver (unofficial driver for IAI actuators)"
            VALUE "ProductVersion", "@IAD_VERSION@"
            VALUE "ABIVersion", "@IAD_ABI_VERSION@"
            VALUE "TestingABIVersion", "@IAD_TESTING_ABI_VERSION@"
            VALUE "Comments", "C ABI @IAD_ABI_VERSION@ (iai_actuator_driver.h); testing header @IAD_TESTING_ABI_VERSION@ (iai_actuator_driver_testing.h)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
